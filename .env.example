# =============================================================================
# intel-payment — deployment configuration
# Every knob here maps 1:1 to a field of metering.Config / billing.Config.
# See docs/configuration.md for the full reference, defaults and failure modes.
# Commercially volatile settings (prices, ceilings, pools, plans, provider accounts, event endpoints)
# are NOT here: they are realm configuration, written through the admin API.
# =============================================================================

# --- Identity -----------------------------------------------------------------
PAYMENT_REALM=default

# --- Stores -------------------------------------------------------------------
# The hot store: balances, outbox STREAMS, idempotency guards. Single primary or Cluster.
# MUST be noeviction + AOF, MUST NOT be shared with a cache, MUST NOT be reachable by hosts —
# write access to it is the ability to mint credits.
PAYMENT_BALANCE_REDIS_URL=redis://payment:CHANGE-ME@redis:6379/0
# The DEPLOY role installs the hot-path functions; the service role cannot. Used by payment-migrate only.
PAYMENT_BALANCE_REDIS_DEPLOY_URL=redis://deploy:CHANGE-ME@redis:6379/0
# The books: ledger, watermarks, guards, payments, configuration.
PAYMENT_LEDGER_DSN=postgres://payment:payment@postgres:5432/payment?sslmode=disable

# --- Sharding -----------------------------------------------------------------
# Every key of a scope carries its shard's hash tag {s<n>}. Recorded in Postgres on first start; a
# process with a different value refuses to start. Changing it is a planned reshard.
PAYMENT_SHARDS=256

# --- Bus ----------------------------------------------------------------------
# redis_streams (default) | nats_jetstream. Money intents live in the Redis outbox either way.
PAYMENT_BUS=redis_streams
PAYMENT_BUS_URL=                        # required for nats_jetstream
PAYMENT_SUBJECT_PREFIX=billing
PAYMENT_BUS_RETENTION=168h              # acked entries kept this long, then trimmed (streams only)
PAYMENT_BUS_MAX_LEN=1000000             # at the cap: backpressure + journal, never trim or drop
PAYMENT_BUS_MAX_ATTEMPTS=5
PAYMENT_BUS_ACK_WAIT=30s                # in-flight reclaim threshold (XAUTOCLAIM / ack-wait)

# --- Settlement ---------------------------------------------------------------
# outbox  = one Redis Function, no durable wait; can lose the last acknowledged intents on a
#           Redis crash/failover (silent under-billing, never double-billing)
# journal = Postgres first, then Redis; no under-bill window
PAYMENT_SETTLEMENT=outbox
PAYMENT_HOT_ACK_WAIT=none               # none | aof_local | aof_replica (outbox only; WAITAOF — needs appendfsync always, or a
                                        # RECORD_TIMEOUT above ~1s under everysec; see docs/configuration.md)
PAYMENT_LEDGER_GRANULARITY=event        # event | rollup (per-batch rows + per-event archive)
PAYMENT_DRAIN_BATCH=500

# --- Idempotency --------------------------------------------------------------
PAYMENT_HOT_IDEM_TTL=24h                # hot guard; MUST NOT exceed the window below
PAYMENT_USAGE_IDEM_WINDOW=72h           # durable usage dedup; MUST exceed every producer's retry horizon
PAYMENT_IDEM_SAFETY_MARGIN=1h           # Record refuses occurred_at older than window - margin
PAYMENT_MAX_CLOCK_SKEW=5m

# --- Reconciliation & recovery ------------------------------------------------
PAYMENT_RECONCILE_INTERVAL=5m           # incremental: scopes booked since the last run
PAYMENT_RECONCILE_FULL_SWEEP_INTERVAL=24h
PAYMENT_RECONCILE_TOLERANCE=0           # drift at EQUAL sequence numbers above this pages
PAYMENT_GAP_TIMEOUT=2m
PAYMENT_TRANSFER_REDRIVE=30s

# --- Worker (payment-worker) ---------------------------------------------------
# A worker holds one Postgres connection per shard it owns: max_connections must cover PAYMENT_SHARDS (+16).
PAYMENT_DRAIN_INTERVAL=250ms            # an idle shard waits this long before it looks again
PAYMENT_OWNERSHIP_RETRY=2s              # unowned shards are tried, held locks checked, this often
PAYMENT_JOURNAL_REPLAY_INTERVAL=5s      # usage journalled during a hot-tier outage is replayed
PAYMENT_WORKER_ADDR=:9091               # /healthz and /metrics of the worker process
PAYMENT_TRANSFER_TRANSIT_ALARM=5m

# --- Hot-path safety ----------------------------------------------------------
PAYMENT_ADMIT_TIMEOUT=250ms
PAYMENT_RECORD_TIMEOUT=500ms
# fail_closed = refuse · fail_open = serve; usage is journaled and metered on recovery
PAYMENT_ADMIT_FAIL_POLICY=fail_closed
PAYMENT_REQUIRE_MAX_COST=false
PAYMENT_MAX_OPERATION_AMOUNT=1125899906842624   # 2^50: keeps hot-tier arithmetic exact

# --- Money policies -----------------------------------------------------------
PAYMENT_NEGATIVE_BALANCE_POLICY=clamp_to_zero   # allow_debt | clamp_to_zero | block_and_flag
PAYMENT_CREDIT_EXPIRY=off                       # off | lots_fefo (spend the soonest-expiring lot first)
PAYMENT_PLAN_CHANGE_POLICY=at_period_end        # at_period_end | immediate_prorate | immediate_no_prorate
PAYMENT_TAX_STRATEGY=provider_managed           # provider_managed | external_hook | none

# --- Payments -----------------------------------------------------------------
# A provider account's credentials are not here: provider_accounts holds references (env:NAME, file:/abs/path) to them.
PAYMENT_WEBHOOK_TOLERANCE=5m            # how far a webhook signature's timestamp may be from when it arrived (max 1h)
PAYMENT_WEBHOOK_TICK_INTERVAL=5s        # payment-worker: how often the webhook inbox is worked (max 1m): a customer who paid waits this long

# --- Dunning ------------------------------------------------------------------
PAYMENT_DUNNING_GRACE_DAYS=7            # whole days, 1-365 (payment-worker)
PAYMENT_DUNNING_SUSPEND_AFTER_DAYS=14   # not read yet: entitlements are Phase 4

# --- Retention ----------------------------------------------------------------
PAYMENT_PAYMENT_EVENT_RETENTION=90d     # webhook inbox, in days (90d) or hours (2160h); MUST exceed the longest provider replay window: at least 7d
PAYMENT_EVENT_RETENTION=30d             # outbound event feed
PAYMENT_LEDGER_ONLINE_RETENTION=unlimited
PAYMENT_USAGE_ARCHIVE_RETENTION=400d    # per-event detail under rollup granularity

# --- Transports ---------------------------------------------------------------
PAYMENT_GRPC_ADDR=:9090
PAYMENT_HTTP_ADDR=:8080                 # REST + admin + webhook ingress + /healthz + /metrics
# An address is host:port, or unix:/path. TLS covers both listeners; mtls requires all three files.
PAYMENT_TLS_CERT_FILE=
PAYMENT_TLS_KEY_FILE=
PAYMENT_TLS_CLIENT_CA_FILE=             # mtls: the private CA a caller's certificate must chain to

# --- Service-to-service auth (see docs/security.md) ---------------------------
# none | mtls | bearer   — `none` is ONLY permitted when bound to loopback/UDS; the service refuses to start otherwise.
PAYMENT_SERVICE_AUTH=bearer
# bearer: <caller-id>:<sha256-hex-of-token>:<realms>:<privileges>, comma-separated.
#   realms: joined with '+'; privileges: record | grant | admin, joined with '+'. Most hosts need only `record`.
#   The configuration holds the DIGEST (`printf %s "$TOKEN" | shasum -a 256`), never the token; a plaintext token
#   here is refused at start-up. Empty = no caller is accepted.
PAYMENT_SERVICE_TOKENS=
# mtls: <caller-id>:<certificate common name>:<realms>:<privileges>, comma-separated (same realms/privileges rules).
PAYMENT_SERVICE_CERTS=

# --- Provider secrets ---------------------------------------------------------
# Provider accounts are realm configuration (provider_accounts rows). A row stores only a
# REFERENCE such as `env:STRIPE_SECRET_KEY`; the values live here or in your secret manager.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# --- Observability ------------------------------------------------------------
PAYMENT_LOG_LEVEL=info                  # debug | info | warn | error
PAYMENT_SHUTDOWN_TIMEOUT=30s            # how long a stop waits for calls in flight; keep below the orchestrator's kill grace period
PAYMENT_OTEL_ENDPOINT=
