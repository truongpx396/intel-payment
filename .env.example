# =============================================================================
# intel-payment — deployment configuration
# Every knob here maps 1:1 to a field of metering.Config / billing.Config.
# See docs/configuration.md for the full reference and defaults.
# =============================================================================

# --- Identity -----------------------------------------------------------------
# Realm isolates one host product's plans, rate cards, limits and ledger from
# another's inside a shared deployment. Single-tenant deployments leave it as-is.
PAYMENT_REALM=default

# --- Stores -------------------------------------------------------------------
# Hot tier: balances, outbox, idempotency guards. MUST be noeviction + AOF.
PAYMENT_BALANCE_REDIS_URL=redis://redis:6379/0
# Durable tier: account_credits, credit_ledger, plans, payments, payment_events.
PAYMENT_LEDGER_DSN=postgres://payment:payment@postgres:5432/payment?sslmode=disable

# --- Bus ----------------------------------------------------------------------
# redis_streams (default) | nats_jetstream
#
# redis_streams needs NO extra infrastructure: the outbox IS the stream, published by the
# same atomic script that moves the balance — so an intent can never exist in the outbox
# but not on the bus. Required infra stays Redis + Postgres.
#
# nats_jetstream when you need quorum replication or cross-region mirroring for money
# intents, or already operate JetStream. Same subjects, same handlers, same invariants.
PAYMENT_BUS=redis_streams
PAYMENT_BUS_URL=                        # empty with redis_streams = reuse the balance Redis
PAYMENT_SUBJECT_PREFIX=billing          # -> billing.deduct.<tag> / billing.grant.<tag>
PAYMENT_BUS_RETENTION=168h              # acked entries kept this long, then trimmed (streams only)
PAYMENT_BUS_MAX_LEN=1000000             # per-stream soft cap; nearing it ALERTS, never trims un-acked
PAYMENT_BUS_MAX_ATTEMPTS=5              # deliveries before an entry goes to the DLQ
PAYMENT_BUS_ACK_WAIT=30s                # in-flight reclaim threshold (XAUTOCLAIM / ack-wait)

# --- Sharding -----------------------------------------------------------------
# Fixed for a deployment's life. N drainers/reconcilers scale under it.
PAYMENT_SHARDS=16

# --- Settlement & reconciliation ----------------------------------------------
# outbox  = 1 atomic Redis step, no durable wait; accepts bounded under-bill RPO
# journal = +1 synchronous durable write before returning; no under-bill
PAYMENT_SETTLEMENT=outbox
PAYMENT_RECONCILE_INTERVAL=1h
PAYMENT_RECONCILE_TOLERANCE=0           # |drift| above this PAGES, never silently heals
PAYMENT_DEFAULT_WARN_AT=0.8             # near-limit warning fraction

# --- Hot-path safety ----------------------------------------------------------
PAYMENT_ADMIT_TIMEOUT=250ms
PAYMENT_RECORD_TIMEOUT=500ms
# fail_open  = serve on hot-store outage (bounded overspend, healed by reconcile)
# fail_closed = refuse
PAYMENT_ADMIT_FAIL_POLICY=fail_closed

# --- Money policies -----------------------------------------------------------
# allow_debt | clamp_to_zero | block_and_flag  (what a refund past spend does)
PAYMENT_NEGATIVE_BALANCE_POLICY=clamp_to_zero
# off | lots_fifo                              (do granted credits expire?)
PAYMENT_CREDIT_EXPIRY=off
# at_period_end | immediate_prorate | immediate_no_prorate
PAYMENT_PLAN_CHANGE_POLICY=at_period_end
# provider_managed | none | external_hook
PAYMENT_TAX_STRATEGY=provider_managed

# --- Dunning ------------------------------------------------------------------
PAYMENT_DUNNING_GRACE_DAYS=7
PAYMENT_DUNNING_SUSPEND_AFTER_DAYS=14

# --- Retention ----------------------------------------------------------------
# MUST exceed the longest provider webhook replay window (Stripe: 3d; be generous).
PAYMENT_PAYMENT_EVENT_RETENTION=90d
PAYMENT_IDEMPOTENCY_CACHE_TTL=24h       # Redis fast-path only; Postgres UNIQUE is the real guard

# --- Transports ---------------------------------------------------------------
PAYMENT_GRPC_ADDR=:9090
PAYMENT_HTTP_ADDR=:8080                 # REST + webhook ingress + /healthz + /metrics

# --- Service-to-service auth (see docs/security.md) ---------------------------
# none | mtls | bearer   — `none` is ONLY permitted when bound to loopback/UDS.
PAYMENT_SERVICE_AUTH=bearer
PAYMENT_SERVICE_TOKENS=                 # comma-separated: <caller-id>:<sha256-of-token>
# Callers allowed to invoke the PRIVILEGED Grant RPC (credit minting).
PAYMENT_GRANT_CALLERS=

# --- Payment providers (all optional; enable only what you sell through) ------
PAYMENT_PROVIDERS_ENABLED=stripe

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox

# --- Observability ------------------------------------------------------------
PAYMENT_LOG_LEVEL=info
PAYMENT_OTEL_ENDPOINT=
