# Equivalent mutants: a mutant no test COULD tell from the code (`a > b` -> `a >= b` where a == b changes
# nothing). scripts/mutation.sh excuses a surviving mutant only when an entry here names its file, its
# operator, its column (from the first non-blank character) and the exact text of its line — so editing
# the line lapses the excuse, and an excuse for one operator never covers a neighbour on the same line.
# Every entry needs a reason (`why`); an entry with none stops the run. A survivor that is NOT equivalent
# is a missing test: write the test, do not add an entry. Reviewed like code (docs/testing.md).

[[equivalent]]
file = "metering/domain/pool.go"
mutator = "CONDITIONALS_BOUNDARY"
col = 29
line = 'return eligible[i].Priority < eligible[j].Priority'
why = "reached only when the priorities differ, so < and <= agree"

