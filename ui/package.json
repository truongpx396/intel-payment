{
  "name": "intel-payment-ui",
  "private": true,
  "type": "module",
  "description": "The browser-facing half of intel-payment: the credits-ui package and its reference binding. Tooling lives here once; each package declares only what a consumer needs.",
  "workspaces": [
    "credits-ui",
    "examples/llm-credits"
  ],
  "scripts": {
    "build": "npm run build -w @intel-payment/credits-ui",
    "typecheck": "npm run build && npm run typecheck --workspaces --if-present",
    "test": "npm run build && npm test --workspaces --if-present",
    "lint": "eslint ."
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.15.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.18.1",
    "fast-check": "^4.10.2",
    "jsdom": "^31.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
